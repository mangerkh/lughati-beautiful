<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="100%" height="100%">
  <defs>
    <linearGradient id="bg1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#bae6fd"/>
      <stop offset="100%" stop-color="#ecfdf5"/>
    </linearGradient>
    <linearGradient id="hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#34d399"/>
      <stop offset="100%" stop-color="#059669"/>
    </linearGradient>
    <linearGradient id="sun" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fde047"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <rect width="400" height="300" rx="20" fill="url(#bg1)"/>
  <!-- Sun -->
  <circle cx="330" cy="70" r="35" fill="url(#sun)"/>
  <circle cx="330" cy="70" r="45" fill="#fef08a" opacity="0.3"/>
  <!-- Clouds -->
  <path d="M50 80 Q65 60 85 70 Q105 50 125 70 Q145 65 140 85 Q145 105 120 100 Q95 110 75 100 Q50 100 50 80 Z" fill="#ffffff" opacity="0.9"/>
  <path d="M220 100 Q235 80 255 90 Q275 70 295 90 Q315 85 310 105 Q315 125 290 120 Q265 130 245 120 Q220 120 220 100 Z" fill="#ffffff" opacity="0.8"/>
  <!-- Hills -->
  <path d="M-20 300 Q90 180 200 240 Q310 300 420 210 L420 300 Z" fill="#10b981" opacity="0.7"/>
  <path d="M-20 300 Q120 200 240 250 Q360 190 420 260 L420 300 Z" fill="url(#hill)"/>
  <!-- Tree -->
  <rect x="110" y="170" width="20" height="60" rx="5" fill="#78350f"/>
  <circle cx="120" cy="150" r="45" fill="#047857"/>
  <circle cx="100" cy="140" r="30" fill="#10b981"/>
  <circle cx="140" cy="140" r="30" fill="#34d399"/>
  <!-- Fruits on tree -->
  <circle cx="105" cy="135" r="7" fill="#ef4444"/>
  <circle cx="130" cy="155" r="7" fill="#ef4444"/>
  <circle cx="115" cy="170" r="7" fill="#ef4444"/>
  <!-- Plant & Wheat -->
  <path d="M250 250 Q260 210 270 250 Q280 200 290 250" stroke="#f59e0b" stroke-width="4" fill="none"/>
  <circle cx="270" cy="205" r="6" fill="#f59e0b"/>
  <circle cx="290" cy="195" r="6" fill="#f59e0b"/>
  <!-- Sparkles -->
  <text x="50" y="220" font-size="28">🌱</text>
  <text x="310" y="240" font-size="28">🌾</text>
  <text x="180" y="270" font-size="24">🏡</text>
  <text x="200" y="150" font-size="28">✨</text>
</svg>
